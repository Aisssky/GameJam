# =============================================
# Unreal Engine 5 .gitignore
# =============================================

# --- Visual Studio / IDE ---
.vs/
*.sln
*.suo
*.user
*.userosscache
*.sln.docstates
*.vcxproj
*.vcxproj.*
*.csproj
*.sln.DotSettings.user

# --- Rider ---
.idea/

# --- Xcode ---
*.xcworkspace
xcuserdata/
DerivedData/
*.xcodeproj

# --- VSCode ---
.vscode/

# --- Intermediate / Build Artifacts ---
Intermediate/
DerivedDataCache/
Saved/
Build/
*.target.xml
*.targetinfo

# --- Binaries ---
Binaries/

# --- Generated Files ---
Source/**/*.generated.h
Source/**/*.generated.cpp

# --- Config (keep Default, ignore others) ---
Config/*.ini
!Config/Default*.ini
!Config/Default*.json
!Config/Default*.xml

# --- Pak / Staging ---
*.pak
*.utoc
*.ucas
Staging/

# --- Content (source assets may be tracked separately) ---
# Uncomment if you store source art assets elsewhere
# Content/

# --- Plugins (ignore binaries/intermediate in plugins) ---
Plugins/*/Binaries/
Plugins/*/Intermediate/

# --- Shader / Material Cache ---
*.ushaderbytecode
*.udebugsymbols

# --- Crash Reports / Logs ---
*.log
CrashReportClient/

# --- Backups / Temp ---
*.backup
*.tmp
*.swp
*~
Backup/

# --- OS Files ---
Thumbs.db
.DS_Store
__MACOSX/

# --- Misc ---
*.ipch
*.pch
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb

# --- Python ---
__pycache__/
*.pyc
*.pyo

# --- Pak Signing ---
*.sig
