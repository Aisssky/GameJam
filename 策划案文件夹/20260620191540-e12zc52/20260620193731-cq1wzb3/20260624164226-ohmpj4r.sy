]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"CanInteract"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"Interactor (Actor)"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"Boolean"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"条件门控，当前是否可交互"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"GetInteractPrompt"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"—"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"Text"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"返回如 \"按E开门\" \"按E阅读\" 的提示文本"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"OnHoverBegin"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"Interactor (Actor)"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"—"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"准星进入范围时的回调"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"OnHoverEnd"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"Interactor (Actor)"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"—"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"准星离开范围时的回调"}]}]}]},{"ID":"20260624164226-adv1g94","Type":"NodeParagraph","Properties":{"id":"20260624164226-adv1g94","updated":"20260624164226"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"使用方法"},{"Type":"NodeText","Data":":"}]},{"ID":"20260624164226-n3thjuj","Type":"NodeList","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260624164226-n3thjuj","updated":"20260624164226"},"Children":[{"ID":"20260624164226-20hsxh9","Type":"NodeListItem","Data":"1.","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260624164226-20hsxh9","updated":"20260624164226"},"Children":[{"ID":"20260624164226-2pg5z7q","Type":"NodeParagraph","Properties":{"id":"20260624164226-2pg5z7q","updated":"20260624164226"},"Children":[{"Type":"NodeText","Data":"任何需要交互的Actor（门、笔记、物品等）在 Class Settings 中添加 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"BPI_Interactable"},{"Type":"NodeText","Data":" 接口"}]}]},{"ID":"20260624164226-05gwhx7","Type":"NodeListItem","Data":"2.","ListData":{"Typ":1,"Tight":true,"Start":2,"Delimiter":46,"Padding":3,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260624164226-05gwhx7","updated":"20260624164226"},"Children":[{"ID":"20260624164226-mb6ayy9","Type":"NodeParagraph","Properties":{"id":"20260624164226-mb6ayy9","updated":"20260624164226"},"Children":[{"Type":"NodeText","Data":"在蓝图内实现上述5个函数"}]}]},{"ID":"20260624164226-po8vc4a","Type":"NodeListItem","Data":"3.","ListData":{"Typ":1,"Tight":true,"Start":3,"Delimiter":46,"Padding":3,"Marker":"My4=","Num":3},"Properties":{"id":"20260624164226-po8vc4a","updated":"20260624164226"},"Children":[{"ID":"20260624164226-vfy7vli","Type":"NodeParagraph","Properties":{"id":"20260624164226-vfy7vli","updated":"20260624164226"},"Children":[{"Type":"NodeText","Data":"交互检测组件通过 Line Trace 找到实现了该接口的 Actor 后，直接调用接口函数"}]}]}]},{"ID":"20260624164226-mhakjel","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260624164226-mhakjel","updated":"20260624164226"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"8.2 交互检测组件"}]},{"ID":"20260624164226-gq6qpgo","Type":"NodeParagraph","Properties":{"id":"20260624164226-gq6qpgo","updated":"20260624164226"},"Children":[{"Type":"NodeText","Data":"在 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"BP_PlayerCharacterB"},{"Type":"NodeText","Data":" 上挂载一个 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"ActorComponent"},{"Type":"NodeText","Data":"（命名为 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"InteractionComponent"},{"Type":"NodeText","Data":"）："}]},{"ID":"20260624164226-3itanzj","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260624164226-3itanzj","updated":"20260624164226"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker"},{"Type":"NodeCodeBlockCode","Data":"Event Tick 中执行:\n  1. LineTraceByChannel 从摄像机位置向前\n     ├── 距离: 250 单位 (可配置变量)\n     ├── 通道: Visibility (或自定义 Interactable 通道)\n     └── 输出: HitResult\n     \n  2. 检查 Hit Actor 是否实现了 BPI_Interactable:\n     ├── 是 且 首次命中该Actor:\n     │   ├── 调用 OnHoverBegin (接口函数)\n     │   ├── 调用 GetInteractPrompt → 显示 WBP_InteractionPrompt\n     │   └── 缓存当前 Hit Actor\n     │\n     ├── 是 且 持续命中 且 玩家按E:\n     │   ├── 调用 CanInteract → 检查条件\n     │   └── 条件通过 → 调用 OnInteract\n     │\n     ├── 命中新Actor:\n     │   ├── 调用旧Actor的 OnHoverEnd\n     │   └── 调用新Actor的 OnHoverBegin\n     │\n     └── 未命中:\n         ├── 调用之前缓存的 Actor 的 OnHoverEnd\n         └── 隐藏 WBP_InteractionPrompt\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260624164226-wrznap6","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260624164226-wrznap6","updated":"20260624164226"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"8.3 蓝图交互"}]},{"ID":"20260624164226-qauqhqs","Type":"NodeParagraph","Properties":{"id":"20260624164226-qauqhqs","updated":"20260624164226"},"Children":[{"Type":"NodeText","Data":"以下是交互需要基于 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"BPI_Interactable"},{"Type":"NodeText","Data":" 接口实现的交互物体："}]},{"ID":"20260624164226-hra4w5x","Type":"NodeTable","Data":"| 交互物 | OnInteract 行为 | CanInteract 条件 | 提示文本 |\n|--------|----------------|-----------------|---------|\n| 门 | 开/关动画，更新 NavMesh | 未被锁 | \"按E开门\" |\n| 笔记/文档 | 显示阅读UI | 无 | \"按E阅读\" |\n| 可拾取物品 | 添加到背包/使用 | 背包有空间 | \"按E拾取\" |\n| 电脑/手机 | 显示终端UI | 剧情条件满足 | \"按E使用\" |\n| 撒作物（驱鬼） | 播放撒作物动画，创建临时安全区 | 持有作物 | \"按E撒作物\" |\n| 特殊颜料 | 涂抹表面使鬼显形 | 持有颜料，目标为玻璃/镜子 | \"按E涂抹\" |","TableAligns":[0,0,0,0],"Properties":{"id":"20260624164226-hra4w5x","updated":"20260624164226"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"交互物"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"OnInteract 行为"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"CanInteract 条件"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"提示文本"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"门"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"开/关动画，更新 NavMesh"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"未被锁"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"\"按E开门\""}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"笔记/文档"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"显示阅读UI"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"无"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"\"按E阅读\""}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"可拾取物品"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"添加到背包/使用"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"背包有空间"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"\"按E拾取\""}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"电脑/手机"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"显示终端UI"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"剧情条件满足"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"\"按E使用\""}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"撒作物（驱鬼）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"播放撒作物动画，创建临时安全区"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"持有作物"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"\"按E撒作物\""}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"特殊颜料"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"涂抹表面使鬼显形"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"持有颜料，目标为玻璃/镜子"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"\"按E涂抹\""}]}]}]},{"ID":"20260624164226-wn93170","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260624164226-wn93170","updated":"20260624164226"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"8.4 交互系统与叙事标记的联动"}]},{"ID":"20260624164226-xyjvmcc","Type":"NodeParagraph","Properties":{"id":"20260624164226-xyjvmcc","updated":"20260624164226"},"Children":[{"Type":"NodeText","Data":"交互程序可以通过检查 NarrativeFlags 来控制交互条件："}]},{"ID":"20260624164226-oxaxgmj","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260624164226-oxaxgmj","updated":"20260624164226"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker"},{"Type":"NodeCodeBlockCode","Data":"示例: 在 CanInteract 函数中:\n  Branch:\n    条件: \"NarrativeFlags 包含 Key = 'NF_Chap2_LearnedProtectionMethod'\"\n    True → 返回 True (允许撒作物/涂颜料)\n    False → 返回 False\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260624164226-c7i8toq","Type":"NodeThematicBreak","Properties":{"id":"20260624164226-c7i8toq","updated":"20260624164226"}},{"ID":"20260624164226-ytog125","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260624164226-ytog125","updated":"20260624164226"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"第9章: 菜单系统 — "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"震Y 负责"}]},{"ID":"20260624164226-uy84fek","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260624164226-uy84fek","updated":"20260624164226"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"9.1 ESC菜单结构"}]},{"ID":"20260624164226-5ip23a7","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260624164226-5ip23a7","updated":"20260624164226"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker"},{"Type":"NodeCodeBlockCode","Data":"WBP_PauseMenu\n├── [保存游戏]   → 覆盖保存 → 显示\"已保存\"(2秒) → 自动关闭\n├── [返回主界面] → 自动保存 → Open Level → L_MainMenu\n└── [返回游戏]   → 关闭菜单 → 回到 NORMAL 状态\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260624164226-725nhmn","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260624164226-725nhmn","updated":"20260624164226"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"9.2 菜单打开/关闭"}]},{"ID":"20260624164226-qz6r2hd","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260624164226-qz6r2hd","updated":"20260624164226"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker"},{"Type":"NodeCodeBlockCode","Data":"打开 (ESC按下, SUBSTATE=NORMAL):\n  1. 设置 SUBSTATE = MENU\n  2. Push IMC_Menu 到输入栈 (Priority 1)\n  3. Set Global Time Dilation = 0       ← 暂停 L2 世界\n  4. Set Show Mouse Cursor = true\n  5. 创建并显示 WBP_PauseMenu\n\n关闭 (ESC再次按下 或 点击\"返回游戏\"):\n  1. 移除 WBP_PauseMenu\n  2. Set Global Time Dilation = 1.0\n  3. Pop IMC_Menu\n  4. Set Show Mouse Cursor = false\n  5. 设置 SUBSTATE = NORMAL\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260624164226-l6m9j5n","Type":"NodeThematicBreak","Properties":{"id":"20260624164226-l6m9j5n","updated":"20260624164226"}},{"ID":"20260624164226-0v8if07","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260624164226-0v8if07","updated":"20260624164226"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"第10章: 游戏机系统 (Console) — "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Sky 负责"}]},{"ID":"20260624164226-85t2y5a","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260624164226-85t2y5a","updated":"20260624164226"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"10.1 组件设计"}]},{"ID":"20260624164226-nluqj9x","Type":"NodeParagraph","Properties":{"id":"20260624164226-nluqj9x","updated":"20260624164226"},"Children":[{"Type":"NodeText","Data":"在 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"BP_PlayerCharacterB"},{"Type":"NodeText","Data":" 上创建 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"ActorComponent"},{"Type":"NodeText","Data":" 蓝图（命名为 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ConsoleComponent"},{"Type":"NodeText","Data":"）："}]},{"ID":"20260624164226-1o8sxs3","Type":"NodeTable","Data":"| 变量 | 类型 | 默认值 | 用途 |\n|------|------|--------|------|\n| `CurrentState` | Enum: Hidden/AnimatingOut/Active/AnimatingAway | Hidden | 当前状态 |\n| `TakeOutAnimation` | AnimMontage 引用 | — | 拿出动画 |\n| `PutAwayAnimation` | AnimMontage 引用 | — | 收起动画 |\n| `AnimationDuration` | Float | 0.5 | 动画时长（秒） |\n| `InputSwitchAtProgress` | Float | 0.5 | 动画播放到多少%时切换输入 |","TableAligns":[0,0,0,0],"Properties":{"id":"20260624164226-1o8sxs3","updated":"20260624164226"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"变量"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"类型"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"默认值"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"用途"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"CurrentState"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"Enum: Hidden/AnimatingOut/Active/AnimatingAway"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"Hidden"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"当前状态"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"TakeOutAnimation"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"AnimMontage 引用"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"—"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"拿出动画"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"PutAwayAnimation"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"AnimMontage 引用"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"—"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"收起动画"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"AnimationDuration"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"Float"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"0.5"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"动画时长（秒）"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"InputSwitchAtProgress"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"Float"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"0.5"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"动画播放到多少%时切换输入"}]}]}]},{"ID":"20260624164226-f6gggqh","Type":"NodeParagraph","Properties":{"id":"20260624164226-f6gggqh","updated":"20260624164226"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Event Dispatcher"},{"Type":"NodeText","Data":":"}]},{"ID":"20260624164226-x5vcd3q","Type":"NodeTable","Data":"| 名称 | 参数 | 用途 |\n|------|------|------|\n| `OnConsoleToggled` | bActive (Boolean) | 通知其他系统 |","TableAligns":[0,0,0],"Properties":{"id":"20260624164226-x5vcd3q","updated":"20260624164226"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"名称"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"参数"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"用途"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"OnConsoleToggled"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"bActive (Boolean)"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"通知其他系统"}]}]}]},{"ID":"20260624164226-u6i1one","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260624164226-u6i1one","updated":"20260624164226"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"10.2 拿出/收起流程"}]},{"ID":"20260624164226-tzmno7n","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260624164226-tzmno7n","updated":"20260624164226"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker"},{"Type":"NodeCodeBlockCode","Data":"▸ 拿出流程:\n  1. Guard: CurrentState == Hidden\n  2. CurrentState = AnimatingOut\n  3. 播放 TakeOutAnimation\n  4. 在动画的 InputSwitchAtProgress 时刻:\n     - 调用 BP_HorrorGameInstance 的层级切换 (→ CONSOLE_ACTIVE)\n     - 显示 WBP_ConsoleUI\n     - 调用 BP_PlayerCharacter.DisableMovement()\n  5. 动画完: CurrentState = Active\n  6. 广播 OnConsoleToggled(true)\n\n▸ 收起流程:\n  1. Guard: CurrentState == Active 或 L4\n  2. CurrentState = AnimatingAway\n  3. 播放 PutAwayAnimation\n  4. 隐藏 WBP_ConsoleUI\n  5. 动画完:\n     - 调用层级切换 (→ OUTER_GAMEPLAY)\n     - 调用 BP_PlayerCharacter.EnableMovement()\n     - CurrentState = Hidden\n  6. 广播 OnConsoleToggled(false)\n\n▸ 强制收起（脚本调用）:\n  1. 跳过动画（或加速至0.2秒）\n  2. 立刻隐藏 WBP_ConsoleUI\n  3. 立刻恢复移动 + 层级切换\n  4. CurrentState = Hidden\n  5. 广播 OnForceConsolePutAway + OnConsoleToggled(false)\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260624164226-6w58y5m","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260624164226-6w58y5m","updated":"20260624164226"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"10.3 视觉方案"}]},{"ID":"20260624164226-j3qck2j","Type":"NodeParagraph","Properties":{"id":"20260624164226-j3qck2j","updated":"20260624164226"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"方案"},{"Type":"NodeText","Data":": UMG 全屏覆盖 + RenderTarget 渲染 L4 3D 场景"}]},{"ID":"20260624164226-m5912f7","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260624164226-m5912f7","updated":"20260624164226"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker"},{"Type":"NodeCodeBlockCode","Data":"WBP_ConsoleUI 布局:\n  ┌──────────────────────────────────┐\n  │          半透明黑色遮罩           │\n  │    ┌────────────────────┐        │\n  │    │                    │        │\n  │    │   游戏机屏幕区域    │        │\n  │    │   (容纳L3/L4内容)  │        │\n  │    │                    │        │\n  │    │  L3: UMG Widget    │        │\n  │    │  L4: RenderTarget  │        │\n  │    │    (简化3D场景)    │        │\n  │    └────────────────────┘        │\n  │          \"按空格收起\"            │\n  └──────────────────────────────────┘\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260624164226-a4xs1dm","Type":"NodeParagraph","Properties":{"id":"20260624164226-a4xs1dm","updated":"20260624164226"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"L4 RenderTarget 方案"},{"Type":"NodeText","Data":":"}]},{"ID":"20260624164226-lhxxbdt","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260624164226-lhxxbdt","updated":"20260624164226"},"Children":[{"ID":"20260624164226-e4li6ut","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260624164226-e4li6ut","updated":"20260624164226"},"Children":[{"ID":"20260624164226-wkfd6a3","Type":"NodeParagraph","Properties":{"id":"20260624164226-wkfd6a3","updated":"20260624164226"},"Children":[{"Type":"NodeText","Data":"使用 SceneCaptureComponent2D 捕捉简化 3D 场景到 RenderTarget"}]}]},{"ID":"20260624164226-zpgbb5j","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260624164226-zpgbb5j","updated":"20260624164226"},"Children":[{"ID":"20260624164226-ee997eq","Type":"NodeParagraph","Properties":{"id":"20260624164226-ee997eq","updated":"20260624164226"},"Children":[{"Type":"NodeText","Data":"RenderTarget 显示在 WBP_ConsoleUI 的 Image 控件中"}]}]},{"ID":"20260624164226-r0t9vfr","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260624164226-r0t9vfr","updated":"20260624164226"},"Children":[{"ID":"20260624164226-wecb1rg","Type":"NodeParagraph","Properties":{"id":"20260624164226-wecb1rg","updated":"20260624164226"},"Children":[{"Type":"NodeText","Data":"L4 场景独立于 L2，使用单独的 Streaming Level（非持久）"}]}]},{"ID":"20260624164226-6jmfuh7","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260624164226-6jmfuh7","updated":"20260624164226"},"Children":[{"ID":"20260624164226-vudaidh","Type":"NodeParagraph","Properties":{"id":"20260624164226-vudaidh","updated":"20260624164226"},"Children":[{"Type":"NodeText","Data":"输入通过 IMC_ConsoleUI 转发到 L4 逻辑"}]}]},{"ID":"20260624164226-pi6jvwh","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260624164226-pi6jvwh","updated":"20260624164226"},"Children":[{"ID":"20260624164226-momqz96","Type":"NodeParagraph","Properties":{"id":"20260624164226-momqz96","updated":"20260624164226"},"Children":[{"Type":"NodeText","Data":"L4 场景 Tick 正常，但 L2 世界不暂停"}]}]}]},{"ID":"20260624164226-yovqcw4","Type":"NodeThematicBreak","Properties":{"id":"20260624164226-yovqcw4","updated":"20260624164226"}},{"ID":"20260624164226-05b650