1pkb","Type":"NodeTable","Data":"| 参数 | 值 | 说明 |\n|------|-----|------|\n| SightRadius | 1500 | 远距离即可察觉 |\n| LoseSightRadius | 2000 | 更难摆脱 |\n| PeripheralVisionAngleDegrees | 90° | 宽视野 |\n| AutoSuccessRangeFromLastSeenLocation | 500 | 失去视线后的宽容范围 |","TableAligns":[0,0,0],"Properties":{"id":"20260624164226-zp51pkb","updated":"20260624164226"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"参数"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"值"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"说明"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"SightRadius"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"1500"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"远距离即可察觉"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"LoseSightRadius"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"2000"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"更难摆脱"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"PeripheralVisionAngleDegrees"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"90°"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"宽视野"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"AutoSuccessRangeFromLastSeenLocation"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"500"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"失去视线后的宽容范围"}]}]}]},{"ID":"20260624164226-zhx3zjg","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260624164226-zhx3zjg","updated":"20260624164226"},"Children":[{"Type":"NodeHeadingC8hMar