NodeText","Data":" = Widget Blueprint 控件蓝图"}]}]},{"ID":"20260624164226-qxpnafx","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260624164226-qxpnafx","updated":"20260624164226"},"Children":[{"ID":"20260624164226-mfomv6z","Type":"NodeParagraph","Properties":{"id":"20260624164226-mfomv6z","updated":"20260624164226"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"策划引用"},{"Type":"NodeText","Data":": 文档中 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"\u0026gt;\u0026gt;"},{"Type":"NodeText","Data":" 开头的引用块表示来自策划文档的原文约束"}]}]},{"ID":"20260624164226-8ny16ox","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260624164226-8ny16ox","updated":"20260624164226"},"Children":[{"ID":"20260624164226-qw2jxc5","Type":"NodeParagraph","Properties":{"id":"20260624164226-qw2jxc5","updated":"20260624164226"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"待确认"},{"Type":"NodeText","Data":": "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[待确认]"},{"Type":"NodeText","Data":" 标记表示需要与策划确认后才能落地的技术决策"}]}]},{"ID":"20260624164226-ubcxsz6","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260624164226-ubcxsz6","updated":"20260624164226"},"Children":[{"ID":"20260624164226-hd9eytk","Type":"NodeParagraph","Properties":{"id":"20260624164226-hd9eytk","updated":"20260624164226"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"暂缓"},{"Type":"NodeText","Data":": "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[暂缓]"},{"Type":"NodeText","Data":" 标记表示当前版本不做，但预留接口"}]}]}]},{"ID":"20260624164226-52q34kf","Type":"NodeThematicBreak","Properties":{"id":"20260624164226-52q34kf","updated":"20260624164226"}},{"ID":"20260624164226-danmomx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260624164226-danmomx","updated":"20260624164226"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"第1章: 总体架构 — "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Sky 负责"}]},{"ID":"20260624164226-xufiy4b","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260624164226-xufiy4b","updated":"20260624164226"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"1.1 四层嵌套模型"}]},{"ID":"20260624164226-lt0u78z","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260624164226-lt0u78z","updated":"20260624164226"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker"},{"Type":"NodeCodeBlockCode","Data":"┌─────────────────────────────────────────┐\n│ LAYER_1 — MainMenu                      │\n│ 独立关卡，纯UMG                         │\n│ ├── 存档管理                            │\n│ ├── 设置                                │\n│ └── 退出游戏                            │\n├─────────────────────────────────────────┤\n│ LAYER_2 — OuterGameplay                 │\n│ 3D持久关卡，B为主角                     │\n│ ├── 运动 / 交互 / 敌人AI / 菜单        │\n│ └── [空格] → 进入 L3                    │\n├─────────────────────────────────────────┤\n│ LAYER_3 — ConsoleUI                     │\n│ UMG覆盖层，L2之上                       │\n│ └── 与L1一致的存档/主菜单界面            │\n├─────────────────────────────────────────┤\n│ LAYER_4 — InnerGameplay                 │\n│ A为主角的嵌套游戏内容 [暂缓]            │\n└─────────────────────────────────────────┘\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260624164226-paukgfp","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260624164226-paukgfp","updated":"20260624164226"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"1.2 层级切换路径"}]},{"ID":"20260624164226-gwwy11r","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260624164226-gwwy11r","updated":"20260624164226"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker"},{"Type":"NodeCodeBlockCode","Data":"允许的转移:\n  L1 ←→ L2    (读档进入 / 退出到主菜单)\n  L2 ←→ L3    (空格键，运行时切换)\n  L3 ←→ L4    (L3内选择读档 / L4内退出)\n\n不允许的转移:\n  L1 → L3/4   (必须先经过L2)\n  L2 ←→ L4    (必须经过L3中转)\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260624164226-re22rwg","Type":"NodeParagraph","Properties":{"id":"20260624164226-re22rwg","updated":"20260624164226"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"约束"},{"Type":"NodeText","Data":":"}]},{"ID":"20260624164226-ic2hato","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260624164226-ic2hato","updated":"20260624164226"},"Children":[{"ID":"20260624164226-luotnog","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260624164226-luotnog","updated":"20260624164226"},"Children":[{"ID":"20260624164226-hlf436f","Type":"NodeParagraph","Properties":{"id":"20260624164226-hlf436f","updated":"20260624164226"},"Children":[{"Type":"NodeText","Data":"L2 ↔ L3 切换时，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"L2 世界持续运行"},{"Type":"NodeText","Data":"（Tick不暂停、AI继续、物理继续）"}]}]},{"ID":"20260624164226-29msw3e","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260624164226-29msw3e","updated":"20260624164226"},"Children":[{"ID":"20260624164226-87e2q08","Type":"NodeParagraph","Properties":{"id":"20260624164226-87e2q08","updated":"20260624164226"},"Children":[{"Type":"NodeText","Data":"L2 内打开 ESC 菜单时，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"L2 世界暂停"},{"Type":"NodeText","Data":"（使用 Set Global Time Dilation 设为 0）"}]}]},{"ID":"20260624164226-4cewrb7","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260624164226-4cewrb7","updated":"20260624164226"},"Children":[{"ID":"20260624164226-kxc25b1","Type":"NodeParagraph","Properties":{"id":"20260624164226-kxc25b1","updated":"20260624164226"},"Children":[{"Type":"NodeText","Data":"菜单暂停 ≠ 游戏机不暂停，这是两个独立机制"}]}]}]},{"ID":"20260624164226-ylq78z1","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260624164226-ylq78z1","updated":"20260624164226"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"1.3 关卡与资源目录"}]},{"ID":"20260624164226-1zcbynq","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260624164226-1zcbynq","updated":"20260624164226"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker"},{"Type":"NodeCodeBlockCode","Data":"Content/\n├── Maps/\n│   ├── L_MainMenu          — L1: 空场景 + UMG\n│   └── L_BGameplay         — L2: 持久关卡（所有游戏内容）\n├── Blueprints/\n│   ├── Core/               — GameInstance, GameMode, 全局管理器\n│   ├── Player/             — BP_PlayerCharacter, BP_PlayerController\n│   ├── Enemy/              — BP_EnemyAI, BT_Enemy\n│   ├── Interaction/        — BPI_Interactable, 交互物体蓝图\n│   ├── UI/                 — 所有 WBP_ Widget\n│   └── Console/            — 游戏机相关蓝图\n├── Input/\n│   ├── Actions/            — IA_* (Input Actions)\n│   └── Contexts/           — IMC_* (Input Mapping Contexts)\n├── Data/\n│   └── DataTables/         — 叙事标记表, 交互物配置\n└── Audio/\n    ├── SoundCues/\n    └── SoundClasses/       — 双层级音频混合用\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260624164226-kc84x6z","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260624164226-kc84x6z","updated":"20260624164226"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"1.4 蓝图类继承关系"}]},{"ID":"20260624164226-2ugi9bt","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260624164226-2ugi9bt","updated":"20260624164226"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker"},{"Type":"NodeCodeBlockCode","Data":"GameInstance\n└── BP_HorrorGameInstance\n    ├── (包含) 层级状态管理器\n    ├── (包含) 存档管理器\n    └── (包含) 叙事事件管理器\n\nGameModeBase\n└── BP_HorrorGameMode\n    ├── BP_MenuGameMode            — L1 使用\n    └── BP_OuterGameplayGameMode   — L2 使用\n\nPlayerController\n└── BP_HorrorPlayerController\n    ├── 持有 IMC 优先级栈逻辑\n    └── 持有各 WBP Widget 引用\n\nCharacter\n└── BP_PlayerCharacterB\n    ├── CameraComponent            — 第一人称相机\n    ├── CharacterMovementComponent\n    ├── (组件) 游戏机控制          — 拿出/收起逻辑\n    └── (组件) 交互检测            — 射线检测+提示\n\nCharacter\n└── BP_EnemyPawn                   — 不可见敌人\n    └── AIController\n        ├── AIPerceptionComponent\n        └── BehaviorTreeComponent\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260624164226-r2fvqsb","Type":"NodeThematicBreak","Properties":{"id":"20260624164226-r2fvqsb","updated":"20260624164226"}},{"ID":"20260624164226-g6onfa6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260624164226-g6onfa6","updated":"20260624164226"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"第2章: 状态机设计 — "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Sky 负责"}]},{"ID":"20260624164226-musexcn","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260624164226-musexcn","updated":"20260624164226"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"2.1 全局层级状态机"}]},{"ID":"20260624164226-4wv1mha","Type":"NodeParagraph","Properties":{"id":"20260624164226-4wv1mha","updated":"20260624164226"},"Children":[{"Type":"NodeText","Data":"由 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"BP_HorrorGameInstance"},{"Type":"NodeText","Data":" 中的层级状态管理器驱动。"}]},{"ID":"20260624164226-1b8w9zi","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260624164226-1b8w9zi","updated":"20260624164226"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker"},{"Type":"NodeCodeBlockCode","Data":"状态枚举 (Blueprint Enum):\n  STATE_MAIN_MENU         — L1 激活\n  STATE_OUTER_GAMEPLAY    — L2 激活，L3/L4 不活跃\n  STATE_CONSOLE_ACTIVE    — L2 运行中，L3 活跃\n  STATE_INNER_GAMEPLAY    — L2 运行中，L4 活跃\n  STATE_CINEMATIC         — 过场动画中（屏蔽所有输入）\n\n转移规则:\n  MAIN_MENU       → OUTER_GAMEPLAY    [Event: OnLoadGame]\n  OUTER_GAMEPLAY  → MAIN_MENU         [Event: OnExitToMenu]\n  OUTER_GAMEPLAY  → CONSOLE_ACTIVE    [Input: Space]\n  CONSOLE_ACTIVE  → OUTER_GAMEPLAY    [Input: Space / ForcePutAway]\n  CONSOLE_ACTIVE  → INNER_GAMEPLAY    [Event: OnInnerGameStart]\n  INNER_GAMEPLAY  → CONSOLE_ACTIVE    [Event: OnInnerGameExit]\n  ANY             → CINEMATIC         [Event: OnCutsceneTrigger]\n  CINEMATIC       → 恢复到之前状态    [Event: OnCutsceneEnd]\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260624164226-07mfwk7","Type":"NodeParagraph","Properties":{"id":"20260624164226-07mfwk7","updated":"20260624164226"},"Children":[{"Type":"NodeTextMark",