Char":42,"Marker":"Kg=="},"Properties":{"id":"20260620204128-xag1r8y","updated":"20260620222656"},"Children":[{"ID":"20260620204128-xdl0qt2","Type":"NodeParagraph","Properties":{"id":"20260620204128-xdl0qt2","updated":"20260620222652"},"Children":[{"Type":"NodeText","Data":"B玩的游戏的主界面 "},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"3"},{"Type":"NodeText","Data":"​"}]},{"ID":"20260620204139-jst7vre","Type":"NodeList","ListData":{},"Properties":{"id":"20260620204139-jst7vre","updated":"20260620222656"},"Children":[{"ID":"20260620204137-and3wh9","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260620204137-and3wh9","updated":"20260620222656"},"Children":[{"ID":"20260620204137-abz1irt","Type":"NodeParagraph","Properties":{"id":"20260620204137-abz1irt","updated":"20260620222656"},"Children":[{"Type":"NodeText","Data":"B玩的以A为主角的游戏内容 "},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"4"},{"Type":"NodeText","Data":"​"}]}]}]}]}]}]}]}]}]},{"ID":"20260620223918-zsun748","Type":"NodeParagraph","Properties":{"id":"20260620223918-zsun748","updated":"20260620224823"},"Children":[{"Type":"NodeText","Data":"要注意的是，这不是一个完全等权承接下来的结构，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"3"},{"Type":"NodeText","Data":"与"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"4"},{"Type":"NodeText","Data":"都可以直接与"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"2"},{"Type":"NodeText","Data":"进行切换，表现形式也就是在2状态下，随时可以拿出游戏机和收起游戏机，并且B在游戏机上玩游戏时，自己世界（"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"2"},{"Type":"NodeText","Data":"）的各种事务还是在进行的。到时候看看有没有实现难度问题或者实操起来的性能问题，有的话可以考虑略微改动框架偷点小懒"}]},{"ID":"20260620224238-zb3l328","Type":"NodeParagraph","Properties":{"id":"20260620224238-zb3l328","updated":"20260620224238"}},{"ID":"20260620211916-1wox4lf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260620211916-1wox4lf","updated":"20260620223032"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"1"},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"mark","TextMarkTextContent":"玩家主界面"}]},{"ID":"20260620220038-xb4nukh","Type":"NodeParagraph","Properties":{"id":"20260620220038-xb4nukh","updated":"20260620220038"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"d9c605f697ba5a129044d5d8af1c1764"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/d9c605f697ba5a129044d5d8af1c1764-20260620220038-dmlxuga.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260620213250-72h5jot","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260620213250-72h5jot","updated":"20260620222458"},"Children":[{"Type":"NodeText","Data":"存档——"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"bc5eb297f31230445333c26af81bd4b5_720"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/bc5eb297f31230445333c26af81bd4b5_720-20260620214530-fuoj46s.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260620214535-yoosqs0","Type":"NodeParagraph","Properties":{"id":"20260620214535-yoosqs0","updated":"20260620215416"},"Children":[{"Type":"NodeText","Data":"第一次打开游戏时，有一个旧存档和一个空档位。“返回”键随时可以点击并返回上一级，已经有存档的档位点击后会“选中”，此存档如按钮下陷，此时可以选择删除或读取。但在玩完全流程之前，旧存档选择后，删除与读取键会被禁用，要么是暗色无响应处理，要么是点完后红亮加禁止音效。而第一次进入游戏时，下面的档位是空档位，点击后会跳出新的一级UI提示“是否创建你的存档”“是”和“否”，选择“否”后返回，选择“是”后创建一个存档，接下来可以选择这个自己创建的存档进行“删除”或“读取”。"}]},{"ID":"20260620215419-y8dblls","Type":"NodeParagraph","Properties":{"id":"20260620215419-y8dblls","updated":"20260620215527"},"Children":[{"Type":"NodeText","Data":"（到时候UI会进一步设计，删除键最好做一下弱化处理，比如暗色以及比读取键小，防止误触，且点击删除后会再次出现一个二级UI再次确认是或否，点读取的话就直接读取）"}]},{"ID":"20260620222440-74pv4oc","Type":"NodeParagraph","Properties":{"id":"20260620222440-74pv4oc","updated":"20260620222458"},"Children":[{"Type":"NodeText","Data":"可以理解为其实就一个档位，上面那个旧存档基本是摆设，先不用管"}]},{"ID":"20260620211916-xo0p3k2","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260620211916-xo0p3k2","updated":"20260620215709"},"Children":[{"Type":"NodeText","Data":"设置——"}]},{"ID":"20260620215702-fzeleym","Type":"NodeParagraph","Properties":{"id":"20260620215702-fzeleym","updated":"20260620215702"},"Children":[{"Type":"NodeText","Data":"就是设置，具体内容以后再说"}]},{"ID":"20260620213133-cmflns2","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260620213133-cmflns2","updated":"20260620220246"},"Children":[{"Type":"NodeText","Data":"退出游戏——"}]},{"ID":"20260620215709-9hzbpai","Type":"NodeParagraph","Properties":{"id":"20260620215709-9hzbpai","updated":"20260620215709"},"Children":[{"Type":"NodeText","Data":"就是退出游戏"}]},{"ID":"20260620211916-1f3ftvv","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260620211916-1f3ftvv","updated":"20260620220246"},"Children":[{"Type":"NodeText","Data":"从“玩家主界面”到下一层级“玩家玩的以B为主角的游戏内容”的唯一途径就是选择第二个存档后点击“读取”"}]},{"ID":"20260620220246-b80501e","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260620220246-b80501e","updated":"20260620223029"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"2"},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"mark","TextMarkTextContent":"玩家玩的以B为主角的游戏内容"}]},{"ID":"20260620211919-5mnzq0f","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260620211919-5mnzq0f","updated":"20260620221228"},"Children":[{"Type":"NodeText","Data":"运动系统"}]},{"ID":"20260620220733-hxce2ij","Type":"NodeParagraph","Properties":{"id":"20260620220733-hxce2ij","updated":"20260620221228"},"Children":[{"Type":"NodeText","Data":"常规的3D第一人称，wsad移动和摄像头旋转，如果要手搓的话记得留一下移动（最大）速度变量和可以禁用移动的接口"}]},{"ID":"20260620220525-0xhkcjy","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260620220525-0xhkcjy","updated":"20260620221305"},"Children":[{"Type":"NodeText","Data":"交互系统"}]},{"ID":"20260620221245-gzk5fai","Type":"NodeParagraph","Properties":{"id":"20260620221245-gzk5fai","updated":"20260620221305"},"Children":[{"Type":"NodeText","Data":"具体包括哪些交互内容还没统筹完，这块我做"}]},{"ID":"20260620220527-zd5qsis","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260620220527-zd5qsis","updated":"20260620222015"},"Children":[{"Type":"NodeText","Data":"敌人系统"}]},{"ID":"20260620221758-jl3w6ez","Type":"NodeParagraph","Properties":{"id":"20260620221758-jl3w6ez","updated":"20260620222015"},"Children":[{"Type":"NodeText","Data":"需要一个能追踪主角且在室内地形环境下知道寻路不会撞墙的敌人AI，基本就恐怖游戏常用的那种鬼AI，默认状态下不需要外观（网格体），所以是不是个pawn都行"}]},{"ID":"20260620220536-shv038k","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260620220536-shv038k","updated":"20260620222749"},"Children":[{"Type":"NodeText","Data":"菜单系统"}]},{"ID":"20260620221959-n3d3x6g","Type":"NodeParagraph","Properties":{"id":"20260620221959-n3d3x6g","updated":"20260620222307"},"Children":[{"Type":"NodeText","Data":"在此层级时（注意前面这五个字），ESC会进入菜单系统，其中包含"}]},{"ID":"20260620222307-k9zw4z9","Type":"NodeList","ListData":{},"Properties":{"id":"20260620222307-k9zw4z9","updated":"20260620222749"},"Children":[{"ID":"20260620222345-txxajst","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260620222345-txxajst","updated":"20260620222345"},"Children":[{"ID":"20260620222345-k5r7fdn","Type":"NodeParagraph","Properties":{"id":"20260620222345-k5r7fdn","updated":"20260620222433"},"Children":[{"Type":"NodeText","Data":"保存游戏——会自动让现在的信息覆盖玩家存档"}]}]},{"ID":"20260620222336-1p85ga3","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260620222336-1p85ga3","updated":"20260620222712"},"Children":[{"ID":"20260620222336-l8evne5","Type":"NodeParagraph","Properties":{"id":"20260620222336-l8evne5","updated":"20260620222712"},"Children":[{"Type":"NodeText","Data":"退出游戏到主界面——顾名思义，从"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"2"},{"Type":"NodeText","Data":"退回到"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"1"},{"Type":"NodeText","Data":"​"}]}]},{"ID":"20260620222341-zwigcwo","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260620222341-zwigcwo","updated":"20260620222749"},"Children":[{"ID":"20260620222341-69qc2ez","Type":"NodeParagraph","Properties":{"id":"20260620222341-69qc2ez","updated":"20260620222749"},"Children":[{"Type":"NodeText","Data":"返回游戏——顾名思义，留在"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"2"},{"Type":"NodeText","Data":"​"}]}]}]},{"ID":"20260620221033-glz9ukj","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260620221033-glz9ukj","updated":"20260620221119"},"Children":[{"Type":"NodeText","Data":"存档系统"}]},{"ID":"20260620221043-e5uacd6","Type":"NodeParagraph","Properties":{"id":"20260620221043-e5uacd6","updated":"20260620221119"},"Children":[{"Type":"NodeText","Data":"需要一个到时候打算动不动写进关卡蓝图里的“自动保存”功能"}]},{"ID":"20260620220850-4eevsho","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260620220850-4eevsho","updated":"20260620220922"},"Children":[{"Type":"NodeText","Data":"UI系统"}]},{"ID":"20260620220901-wxyd5nx","Type":"NodeParagraph","Properties":{"id":"20260620220901-wxyd5nx","updated":"20260620220922"},"Children":[{"Type":"NodeText","Data":"到时候再说"}]},{"ID":"20260620211919-6hsp3c6","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260620211919-6hsp3c6","updated":"20260620223632"},"Children":[{"Type":"NodeText","Data":"玩游戏系统"}]},{"ID":"20260620211919-f8dq9bw","Type":"NodeParagraph","Properties":{"id":"20260620211919-f8dq9bw","updated":"20260620223632"},"Children":[{"Type":"NodeText","Data":"按空格（暂定）键拿出主机玩游戏 （从"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"2"},{"Type":"NodeText","Data":"进入到"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"3"},{"Type":"NodeText","Data":"），注意，此时"},{"Type":"NodeT