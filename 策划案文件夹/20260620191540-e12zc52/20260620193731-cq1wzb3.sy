12-li319vc","Type":"NodeHeading","HeadingLevel":3,"Properties":{"fold":"1","heading-fold":"1","id":"20260621202512-li319vc","updated":"20260621201547"},"Children":[{"Type":"NodeText","Data":"以及按空格放下游戏机停止玩游戏这么个事，我在"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"2"},{"Type":"NodeText","Data":"提过了，就不再重复了"}]},{"ID":"20260621202512-iewvrae","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260621202512-iewvrae","updated":"20260621200526"}},{"ID":"20260621202512-tvq8sjd","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260621202512-tvq8sjd","updated":"20260621201547"}},{"ID":"20260621202512-qdjet40","Type":"NodeHeading","HeadingLevel":2,"Properties":{"fold":"1","heading-fold":"1","id":"20260621202512-qdjet40","updated":"20260621202528"},"Children":[{"Type":"NodeText","Data":"角色B按键绑定"}]},{"ID":"20260621202512-29v2u3e","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260621202512-29v2u3e","updated":"20260620223457"},"Children":[{"Type":"NodeText","Data":"WSAD——前后左右"}]},{"ID":"20260621202512-kgdcv93","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260621202512-kgdcv93","updated":"20260621201202"},"Children":[{"Type":"NodeText","Data":"ESC——在“游戏状态下”打开菜单，即只有"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"2"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"4"},{"Type":"NodeText","Data":"​时可用，打开状态下再按继续游戏"}]},{"ID":"20260621202512-32p9sdr","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260621202512-32p9sdr","updated":"20260620223559"},"Children":[{"Type":"NodeText","Data":"E——交互"}]},{"ID":"20260621202512-19p66ty","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260621202512-19p66ty","updated":"20260621193920"},"Children":[{"Type":"NodeText","Data":"空格——"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"2"},{"Type":"NodeText","Data":"的情况下拿出游戏机使得可进入"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"3与4"},{"Type":"NodeText","Data":"状态（此时手持物品切换为游戏机），再按回到"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"2"}]},{"ID":"20260621202512-ubgazdt","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260621202512-ubgazdt","updated":"20260621193903"},"Children":[{"Type":"NodeText","Data":"1——有枪后将手持物品切换为枪"}]},{"ID":"20260621202512-pchd45v","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260621202512-pchd45v","updated":"20260621193931"},"Children":[{"Type":"NodeText","Data":"2——有符咒后将手持物品切换为符咒"}]},{"ID":"20260621202512-zs1baa6","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260621202512-zs1baa6","updated":"20260621193940"},"Children":[{"Type":"NodeText","Data":"左键——有枪后射击"}]},{"ID":"20260621202512-fuaonjo","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260621202512-fuaonjo","updated":"20260621193948"},"Children":[{"Type":"NodeText","Data":"右键——有枪后瞄准"}]},{"ID":"20260621202512-tf7o7ep","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260621202512-tf7o7ep","updated":"20260621193959"},"Children":[{"Type":"NodeText","Data":"F键——有符咒后贴符"}]},{"ID":"20260621202512-ste2kls","Type":"NodeHeading","HeadingLevel":2,"Properties":{"fold":"1","heading-fold":"1","id":"20260621202512-ste2kls","updated":"20260621202531"},"Children":[{"Type":"NodeText","Data":"角色A按键绑定"}]},{"ID":"20260621202512-c24v5yi","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260621202512-c24v5yi","updated":"20260621200829"},"Children":[{"Type":"NodeText","Data":"AD——左右"}]},{"ID":"20260621202512-cplhnie","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260621202512-cplhnie","updated":"20260621201425"},"Children":[{"Type":"NodeText","Data":"ESC——打开菜单，打开状态下再按继续游戏"}]},{"ID":"20260621202512-e36vmjn","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260621202512-e36vmjn","updated":"20260621201216"},"Children":[{"Type":"NodeText","Data":"E——交互"}]},{"ID":"20260621202512-jvnwid8","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260621202512-jvnwid8","updated":"20260621201453"},"Children":[{"Type":"NodeText","Data":"空格——放下游戏机，会自动暂停游戏"}]},{"ID":"20260621202512-qr48ctg","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260621202512-qr48ctg","updated":"20260620223908"}},{"ID":"20260621202512-vg2ns1e","Type":"NodeHeading","HeadingLevel":2,"Properties":{"fold":"1","heading-fold":"1","id":"20260621202512-vg2ns1e","updated":"20260621202535"},"Children":[{"Type":"NodeText","Data":"暂时搁置的部分，未来可考虑加花"}]},{"ID":"20260621202512-6rgr0cy","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260621202512-6rgr0cy","updated":"20260621194313"},"Children":[{"Type":"NodeText","Data":"恐怖程度选择、配音、跑步频率的调整、手柄兼容"}]},{"ID":"20260620193731-b7w57q4","Type":"NodeHeading","HeadingLevel":1,"Properties":{"fold":"1","id":"20260620193731-b7w57q4","updated":"20260626181831"},"Children":[{"Type":"NodeText","Data":"关卡设计"}]},{"ID":"20260626181831-nt1ah80","Type":"NodeHeading","HeadingLevel":2,"Properties":{"fold":"1","heading-fold":"1","id":"20260626181831-nt1ah80","updated":"20260626181831"},"Children":[{"Type":"NodeText","Data":"B部分地图"}]},{"ID":"20260626181831-6t10zld","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181831-6t10zld","updated":"20260621135410"},"Children":[{"Type":"NodeText","Data":"1 给流程玩法服务，当关卡设计"}]},{"ID":"20260626181831-724m8ge","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181831-724m8ge","updated":"20260626154906"},"Children":[{"Type":"NodeText","Data":"一楼要保证可以打枪封门溜鬼，即空间够大且相互联通，没什么死路，且有门能把空间分隔开。（如果同时存在两个联通一二楼的楼梯的话，也可以把二楼也加入到这个空间循环里）"}]},{"ID":"20260626181831-5a7epnl","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181831-5a7epnl","updated":"20260621135432"},"Children":[{"Type":"NodeText","Data":"2 参考现实里美国房子"}]},{"ID":"20260626181831-uckgr70","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181831-uckgr70","updated":"20260626154618"},"Children":[{"Type":"NodeText","Data":"主要材质是木头，刷涂料。一楼联通的公共空间，C位要有一个壁炉。二楼是前期主空间，有至少两个卧室以及单独的卫浴，要注意主角屋子开门是一个长廊，能接到过堂风。三楼阁楼有只去一次的小杂物间，地下室不要了。主要锚点：壁炉必须在客厅C位，窗户是上下滑动开启的“上下推拉窗”，门把手是圆球或下压式机械锁。可以参考《招魂》和《潜伏2》的房屋设计。"}]},{"ID":"20260626181831-jvygpqo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"fold":"1","heading-fold":"1","id":"20260626181831-jvygpqo","updated":"20260626181831"},"Children":[{"Type":"NodeText","Data":"A部分高塔部分地图"}]},{"ID":"20260626181831-19d9qfq","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181831-19d9qfq","updated":"20260626155249"},"Children":[{"Type":"NodeText","Data":"整体类似于平台跳跃，要不断通过跳跃和爬梯子往高处去，要让角色有失误可能性(跳向高平台时失败掉到下面的平台)，但又要避免一下子掉到特别低的地方。整个无失误爬塔时长最好能有两分半左右。"}]},{"ID":"20260626181831-sf7njj7","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181831-sf7njj7","updated":"20260626155327"},"Children":[{"Type":"NodeText","Data":"设定上是一座废弃高塔，所以随便点设计就行，不要太注重是否符合现实。"}]},{"ID":"20260621202608-w33oxu4","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260621202608-w33oxu4","updated":"20260621135410"},"Children":[{"Type":"NodeText","Data":"1 给流程玩法服务，当关卡设计"}]},{"ID":"20260621202608-sc548jz","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260621202608-sc548jz","updated":"20260621135432"},"Children":[{"Type":"NodeText","Data":"2 参考现实里美国房子"}]},{"ID":"20260620201656-q6kdugd","Type":"NodeHeading","HeadingLevel":1,"Properties":{"fold":"1","id":"20260620201656-q6kdugd","updated":"20260621202651"},"Children":[{"Type":"NodeText","Data":"流程脚本"}]},{"ID":"20260621202651-kt1zvng","Type":"NodeHeading","HeadingLevel":2,"Properties":{"fold":"1","heading-fold":"1","id":"20260621202651-kt1zvng","updated":"20260621202641"},"Children":[{"Type":"NodeText","Data":"游戏流程三个阶段"}]},{"ID":"20260621202651-2jm7hbw","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260621202651-2jm7hbw","updated":"20260621150238"},"Children":[{"Type":"NodeTextMark","TextMarkType":"mark","TextMarkTextContent":"一阶段"},{"Type":"NodeText","Data":"不知道有鬼阶段（没有异常和刚出现异常但不确定是否非自然）——"},{"Type":"NodeTextMark","TextMarkType":"mark","TextMarkTextContent":"二阶段"},{"Type":"NodeText","Data":"知道有鬼但不知道怎么处理的纯恐怖被动阶段——"},{"Type":"NodeTextMark","TextMarkType":"mark","TextMarkTextContent":"三阶段"},{"Type":"NodeText","Data":"​知道鬼的（假）来历，根据帮助抵抗鬼以及完成仪式的阶段"}]},{"ID":"20260621202651-f7bpuak","Type":"NodeHeading","HeadingLevel":2,"Properties":{"fold":"1","heading-fold":"1","id":"20260621202651-f7bpuak","updated":"20260621202643"},"Children":[{"Type":"NodeText","Data":"简略版"}]},{"ID":"20260621202651-5hw7e2k","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260621202651-5hw7e2k","updated":"20260621182357"},"Children":[{"Type":"NodeText","Data":"玩家进入游戏——（选择难度）——获取玩家与门的相对位置——点存档——发现有旧存档，且无法操作——创建新存档并载入——开始操控B（"},{"Type":"NodeTextMark","TextMarkType":"mark","TextMarkTextContent":"一阶段"},{"Type":"NodeText","Data":"）——（此时是黄昏）坐在桌子前，有一个清单：父母留的，说这两天我们出差，你记得把每天的家务处理好，然后做你自己的事（玩游戏）——此时交互游戏机会显示“里面的游戏都玩过很多遍了，要玩也是先做完家务再玩吧”——去做家务，这个过程设计好路线，尽可能让他熟悉房间构造——做完刚要回去玩游戏，听到楼下的敲门声——过去后发现送来的游戏卡带，以及一封匿名信，说是某个朋友送给自己的惊喜礼物，门口空无一人——主角很开心地回去插入卡带玩新游戏——遇到和玩家玩游戏一样的主界面以及存档情况（有一个无法干涉的旧存档）——"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"主角玩着玩着游戏，突然失去了对控制角色的控制权，然后里面的角色突然转头看向主角（A1）。此时主角卧室房门突然打开，以及一个水杯（或者什么）掉在地上"},{"Type":"NodeText","Data":"——主角受惊放下游戏机，起身查看，发现可能只是走廊对侧的风太大，把房门吹开（房门向里开）以及吹掉了水杯，且此时已经到了夜晚——回去继续玩游戏（A2），然后听到一楼传来动静，以为是父母回来了，过去查看，结果空无一人，并且大门被从外面封住——"},{"Type":"NodeTextMark","TextMarkType":"mark","TextMarkTextContent":"进入二阶段"},{"Type":"NodeText","Data":" 在往回走的路上直接遇到灵异事件，（"},{"Type":"NodeTextMark","TextMarkType":"mark","TextMarkTextContent":"此处对关卡设计有需求"},{"Type":"NodeText","Data":"），B被迫绕路且被惊吓着往屋里跑——回去后锁住门，门口传来一会儿拍门声与吼叫声后消失（玩家门口也会出现），此时他发现游戏机里的人看着他并发出笑声，他意识到这个游戏可能不太对劲，于是打开电脑搜索这个游戏名，发现没有任何相关信息，于是去论坛上求助，有一个人回应，表示自己的家族曾经是巫师的一脉，他听说过一种夺舍术法，能把冤魂寄宿在书籍里，随着信息的摄入，冤魂就会出现在现实中不断干扰受害者的现实生活，甚至加害于他，只有读完信息体会了冤魂的痛苦，并随后剔除掉书上的契印，冤魂才能被超度。对方认为主角现在正在玩的游戏是这种巫术的现代变体，恐怕必须要玩完游戏全程，并删除掉旧存档，才能超度冤魂——并告诉了他与鬼对抗的方法，对方可以支援邮递某种驱邪道具过来，他接下来需要在鬼的追击下利用道具来和鬼周旋，一边躲避追击一边完成剩余的游戏流程——在等待送来快递的时候完成（A3）——"},{"Type":"NodeTextMark","TextMarkType":"mark","TextMarkTextContent":"进入三阶段"},{"Type":"NodeText","Data":" 一段gameplay，此时鬼被门阻挡拍门时玩家也能听到自己被拍门，玩家边躲鬼边完成剩下游戏流程（A4）——最终完成了游戏流程，按照要求回到自己的房间，给门贴上符咒，在鬼的一阵阵拍门声与怒吼声中删除了旧存档。这时候外面传来逐渐微弱的惨叫声，游戏里的主角A也再次meta乱入到屏幕上，告诉了他事情的真相，主角意识也逐渐模糊——逐渐闪回他当时变为游魂那部分的绝望记忆——再次醒来时已经是从屏幕往外看的视角，自己的身体已经被A夺舍，A发表胜利宣言（——游戏黑屏，B讲述自己的结局，然后随着言说事情变得不对起来，使玩家意识到自己也完成了被夺舍的条件，且自己的门外不断传来拍门声与怒吼声，屏幕跳到存档界面，此时锁定旧存档，返回、删除、读取键全都变成“删除”。玩家被迫点后或10秒不点自动点后一切寂静下来，游戏结束并附上开发者感谢黑屏。"}]},{"ID":"20260626181804-6m80jv0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-6m80jv0","updated":"20260626181804"},"Children":[{"Type":"NodeText","Data":"游戏流程三个阶段"}]},{"ID":"20260626181804-4paypto","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-4paypto","updated":"20260621150238"},"Children":[{"Type":"NodeTextMark","TextMarkType":"mark","TextMarkTextContent":"一阶段"},{"Type":"NodeText","Data":"不知道有鬼阶段（没有异常和刚出现异常但不确定是否非自然）——"},{"Type":"NodeTextMark","TextMarkType":"mark","TextMarkTextContent":"二阶段"},{"Type":"NodeText","Data":"知道有鬼但不知道怎么处理的纯恐怖被动阶段——"},{"Type":"NodeTextMark","TextMarkType":"mark","TextMarkTextContent":"三阶段"},{"Type":"NodeText","Data":"​知道鬼的（假）来历，根据帮助抵抗鬼以及完成仪式的阶段"}]},{"ID":"20260626181804-dtlqwlo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-dtlqwlo","updated":"20260626181804"},"Children":[{"Type":"NodeText","Data":"简略版"}]},{"ID":"20260626181804-t87xyze","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-t87xyze","updated":"20260624232807"},"Children":[{"Type":"NodeText","Data":"玩家进入游戏——（选择难度）——获取玩家与门的相对位置——点存档——发现有旧存档，且无法操作——创建新存档并载入——开始操控B（"},{"Type":"NodeTextMark","TextMarkType":"mark","TextMarkTextContent":"一阶段"},{"Type":"NodeText","Data":"）——（此时是黄昏）坐在桌子前，有一个清单：父母留的，说这两天我们出差，你记得把每天的家务处理好，然后做你自己的事（玩游戏）——此时交互游戏机会显示“里面的游戏都玩过很多遍了，要玩也是先做完家务再玩吧”——去做家务，这个过程设计好路线，尽可能让他熟悉房间构造——做完刚要回去玩游戏，听到楼下的敲门声——过去后发现送来的游戏卡带，以及一封匿名信，说是某个朋友送给自己的惊喜礼物，门口空无一人——主角很开心地回去插入卡带玩新游戏——遇到和玩家玩游戏一样的主界面以及存档情况（有一个无法干涉的旧存档）——"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"主角玩着玩着游戏，突然失去了对控制角色的控制权，然后里面的角色突然转头看向主角（A1）。此时主角卧室房门突然打开，以及一个水杯（或者什么）掉在地上"},{"Type":"NodeText","Data":"——主角受惊放下游戏机，起身查看，发现可能只是走廊对侧的风太大，把房门吹开（房门向里开）以及吹掉了水杯，且此时已经到了夜晚——回去继续玩游戏（A2），然后听到一楼传来动静，以为是父母回来了，过去查看，结果空无一人，并且大门被从外面封住——"},{"Type":"NodeTextMark","TextMarkType":"mark","TextMarkTextContent":"进入二阶段"},{"Type":"NodeText","Data":" 在往回走的路上直接遇到灵异事件，（"},{"Type":"NodeTextMark","TextMarkType":"mark","TextMarkTextContent":"此处对关卡设计有需求"},{"Type":"NodeText","Data":"），B被迫绕路且被惊吓着往屋里跑——回去后锁住门，门口传来一会儿拍门声与吼叫声后消失（玩家门口也会出现），此时他发现游戏机里的人看着他并发出笑声，他意识到这个游戏可能不太对劲，于是打开电脑搜索这个游戏名，发现没有任何相关信息，于是去论坛上求助，有一个人回应，表示自己的家族曾经是巫师的一脉，他听说过一种夺舍术法，能把冤魂寄宿在书籍里，随着信息的摄入，冤魂就会出现在现实中不断干扰受害者的现实生活，甚至加害于他，只有读完信息体会了冤魂的痛苦，并随后剔除掉书上的契印，冤魂才能被超度。对方认为主角现在正在玩的游戏是这种巫术的现代变体，恐怕必须要玩完游戏全程，并删除掉旧存档，才能超度冤魂——并告诉了他与鬼对抗的方法，对方可以支援邮递某种驱邪道具过来，他接下来需要在鬼的追击下利用道具来和鬼周旋，一边躲避追击一边完成剩余的游戏流程——在等待送来快递的时候完成（A3）——"},{"Type":"NodeTextMark","TextMarkType":"mark","TextMarkTextContent":"进入三阶段"},{"Type":"NodeText","Data":" 一段gameplay，此时鬼被门阻挡拍门时玩家也能听到自己被拍门，玩家边躲鬼边完成剩下游戏流程（A4）（我想在这段来一段后朋些的配乐）——最终完成了游戏流程，按照要求回到自己的房间，给门贴上符咒，在鬼的一阵阵拍门声与怒吼声中删除了旧存档。这时候外面传来逐渐微弱的惨叫声，游戏里的主角A也再次meta乱入到屏幕上，告诉了他事情的真相，主角意识也逐渐模糊——逐渐闪回他当时变为游魂那部分的绝望记忆——再次醒来时已经是从屏幕往外看的视角，自己的身体已经被A夺舍，A发表胜利宣言（——游戏黑屏，B讲述自己的结局，然后随着言说事情变得不对起来，使玩家意识到自己也完成了被夺舍的条件，且自己的门外不断传来拍门声与怒吼声，屏幕跳到存档界面，此时锁定旧存档，返回、删除、读取键全都变成“删除”。玩家被迫点后或10秒不点自动点后一切寂静下来，游戏结束并附上开发者感谢黑屏。"}]},{"ID":"20260626181804-szfky2s","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-szfky2s","updated":"20260621202101"},"Children":[{"Type":"NodeText","Data":"（注：此处的A1 A2 A3 A4是代指玩游戏机的4段流程区分）"}]},{"ID":"20260626181804-etk6p3p","Type":"NodeHeading","HeadingLevel":2,"Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-etk6p3p","updated":"20260626181804"},"Children":[{"Type":"NodeText","Data":"详细版"}]},{"ID":"20260626181804-hny3lvw","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-hny3lvw","updated":"20260626161850"},"Children":[{"Type":"NodeText","Data":"玩家进入游戏——（选择难度）——获取玩家与门的相对位置——点存档——发现有旧存档，且无法操作——创建新存档并载入——开始操控B（"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一阶段"},{"Type":"NodeText","Data":"）"}]},{"ID":"20260626181804-0a7byjr","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-0a7byjr","updated":"20260626161905"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-card-info-background); color: var(--b3-card-info-color);"},"TextMarkType":"text","TextMarkTextContent":"B1"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-card-info-background); color: var(--b3-card-info-color);\"}"},{"Type":"NodeText","Data":"："}]},{"ID":"20260626181804-aruo3fa","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-aruo3fa","updated":"20260626161848"},"Children":[{"Type":"NodeText","Data":"——（"},{"Type":"NodeTextMark","TextMarkType":"mark","TextMarkTextContent":"一段运镜"},{"Type":"NodeText","Data":"，从外面的走廊窗户，到进入窗户来到走廊，经过一面镜子，球朝着远离镜子的方向滚动，经过一个上面放着水杯的桌子，再跨过房门进入B的卧室，先经过父母留的纸条（不做停留，只做提醒），最后停在游戏机上，然后以B的手伸到桌子上按住清单结束，摄像头重叠到主角头上）——坐在桌子前，有一个"},{"Type":"NodeTextMark","TextMarkType":"mark","TextMarkTextContent":"清单"},{"Type":"NodeText","Data":"：父母留的，说这两天我们出差，你在家里好好呆着，把家务做好，不要再到处惹事——此时交互游戏机会显示“里面的游戏都玩过很多遍了，要玩也是先做完家务再玩吧”——去做家务，这个过程设计好"},{"Type":"NodeTextMark","TextMarkType":"mark","TextMarkTextContent":"路线"},{"Type":"NodeText","Data":"，尽可能让他熟悉房间构造，能把最后追逐对抗战可以走的联通路线全走完——做完刚要回屋，听到楼下的敲门声——过去后发现送来的游戏卡带，以及一封匿名信，说是某个朋友（称自己为大哥）送给自己的惊喜礼物，门口空无一人——主角回去插入卡带玩新游戏——遇到和玩家玩游戏一样的主界面以及存档情况（有一个无法干涉的旧存档）——"}]},{"ID":"20260626181804-lx2s5tz","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-lx2s5tz","updated":"20260626161131"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-card-error-background); color: var(--b3-card-error-color);"},"TextMarkType":"mark text","TextMarkTextContent":"A1"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-card-error-background); color: var(--b3-card-error-color);\"}"},{"Type":"NodeText","Data":"："}]},{"ID":"20260626181804-w5keg6z","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-w5keg6z","updated":"20260626163044"},"Children":[{"Type":"NodeText","Data":"场景一，有点破败、沿途有好几个垃圾桶的美国街巷，比较长，是A的上学路——A走在上学路，自述自己的家庭背景，场景终点处交互开门（以后每个场景连接也是开门，不再重复）"}]},{"ID":"20260626181804-5yma3r2","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-5yma3r2","updated":"20260626162441"},"Children":[{"Type":"NodeText","Data":"场景二，学校食堂，背景里还有不少在吃饭的人影——这里先有个按E吃饭，A进行到上面那段叙述的结尾，然后餐盘被B故意碰掉，讲述自己被B欺负的开始"}]},{"ID":"20260626181804-lrt3evu","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-lrt3evu","updated":"20260626173924"},"Children":[{"Type":"NodeText","Data":"场景三，更衣室，A第一次被B带人揍了一顿（我有点考虑要不要把B和他的跟班们做成魔鬼的形象）——简单展示，被打过程用黑屏处理，被打完A坐在那里带着怨气地叙述着，接着突然不说话，然后慢慢盯着屏幕外的玩家（这里要一个阴阳脸打光）"}]},{"ID":"20260626181804-zkcomrn","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-zkcomrn","updated":"20260626161909"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-card-info-background); color: var(--b3-card-info-color);"},"TextMarkType":"text","TextMarkTextContent":"B2"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-card-info-background); color: var(--b3-card-info-color);\"}"},{"Type":"NodeText","Data":"："}]},{"ID":"20260626181804-mcu1pq6","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-mcu1pq6","updated":"20260626161924"},"Children":[{"Type":"NodeText","Data":"——B对此感到惊慌，此时B卧室房门突然打开，以及一个水杯（或者什么）从外面滚了进来——B受惊放下游戏机，起身查看，发现可能只是走廊对侧的风太大，把房门吹开（房门向里开）以及吹掉了水杯，且发现此时已经到了夜晚——回去继续玩游戏——"}]},{"ID":"20260626181804-q9k022w","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-q9k022w","updated":"20260626161804"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-card-error-background); color: var(--b3-card-error-color);"},"TextMarkType":"mark text","TextMarkTextContent":"A2"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-card-error-background); color: var(--b3-card-error-color);\"}"},{"Type":"NodeText","Data":":"}]},{"ID":"20260626181804-6ksriko","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-6ksriko","updated":"20260626162852"},"Children":[{"Type":"NodeText","Data":"场景一，家里的餐桌，家比较穷，所以场景最好“烂”一点，背景里不起眼的地方要有电动车和笔记本电脑——与父亲交谈以及演变为吵架"}]},{"ID":"20260626181804-9rl5pfy","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-9rl5pfy","updated":"20260626163004"},"Children":[{"Type":"NodeText","Data":"插图一，一座高塔从地面向上仰视的“全身”图"}]},{"ID":"20260626181804-lj9h19c","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-lj9h19c","updated":"20260626163204"},"Children":[{"Type":"NodeText","Data":"场景二，整座高塔的超长背景（可以偷懒重复几次）——爬塔环节"}]},{"ID":"20260626181804-jvttiwq","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-jvttiwq","updated":"20260626163748"},"Children":[{"Type":"NodeText","Data":"场景三，塔的顶部内外，具体来讲有一个不怎么长的延伸平台，里面风格还是塔，外边是星空和下面城市的光亮"}]},{"ID":"20260626181804-ln432xp","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-ln432xp","updated":"20260626163819"},"Children":[{"Type":"NodeText","Data":"插图二，从塔顶向下看城市的俯视图"}]},{"ID":"20260626181804-3nqhec8","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-3nqhec8","updated":"20260626162219"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-card-info-background); color: var(--b3-card-info-color);"},"TextMarkType":"text","TextMarkTextContent":"B3"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-card-info-background); color: var(--b3-card-info-color);\"}"},{"Type":"NodeText","Data":"："}]},{"ID":"20260626181804-ld4ea0n","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-ld4ea0n","updated":"20260626165140"},"Children":[{"Type":"NodeText","Data":"——听到一楼传来动静，以为是父母回来了，过去查看，结果空无一人，并且大门被从外面封住——"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"进入二阶段"},{"Type":"NodeText","Data":" 在往回走的路上直接遇到灵异事件，（"},{"Type":"NodeTextMark","TextMarkType":"mark","TextMarkTextContent":"此处对关卡设计有需求，等做完再设计具体脚本"},{"Type":"NodeText","Data":"），B被迫绕路且被惊吓着往屋里跑——回去后锁住门，门口传来一会儿拍门声与吼叫声后消失（玩家门口也会出现），此时他发现游戏机里的人看着他并发出笑声（带一点报复和苦笑意味的笑声），他意识到这个游戏可能不太对劲，于是打开电脑搜索这个游戏名，发现没有任何相关信息，于是去论坛上求助，有一个人回应，表示自己曾对巫术有一些了解，他听说过一种夺舍术法，能把冤魂寄宿在书籍里，随着信息的摄入，冤魂就会出现在现实中不断干扰受害者的现实生活，甚至加害于他，只有读完信息体会了冤魂的痛苦，并随后剔除掉书上的契印，冤魂才能被超度。对方认为主角现在正在玩的游戏是这种巫术的现代变体，恐怕必须要玩完游戏全程，并删除掉旧存档，才能超度冤魂——并告诉了他与鬼对抗的方法，对方可以支援邮递某种驱邪道具过来（银弹和符咒），他接下来需要在鬼的追击下利用道具来和鬼周旋，一边躲避追击一边完成剩余的游戏流程（由于完成的进度越长，鬼魂的意识清晰度和攻击性越强，所以不能一直躲在屋里完成剩余进度）——在等待送来快递的时候继续完成游戏——"}]},{"ID":"20260626181804-u7079bx","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-u7079bx","updated":"20260626165351"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-card-error-background); color: var(--b3-card-error-color);"},"TextMarkType":"mark text","TextMarkTextContent":"A3"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-card-error-background); color: var(--b3-card-error-color);\"}"},{"Type":"NodeText","Data":":"}]},{"ID":"20260626181804-5z379w1","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-5z379w1","updated":"20260626165521"},"Children":[{"Type":"NodeText","Data":"场景一，用过的更衣室场景——B变本加厉"}]},{"ID":"20260626181804-npairn2","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-npairn2","updated":"20260626165544"},"Children":[{"Type":"NodeText","Data":"场景二，用过的家的场景——偷钥匙"}]},{"ID":"20260626181804-rxz3r9l","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-rxz3r9l","updated":"20260626165640"},"Children":[{"Type":"NodeText","Data":"场景三，地下室场景，比较有巫师地下室那种破败且带点邪性的感觉，色调脏黄一些——阅读典籍，知道自己一族确实是巫师家"}]},{"ID":"20260626181804-5sgckpr","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-5sgckpr","updated":"20260626165800"},"Children":[{"Type":"NodeText","Data":"场景四，家门口的街道（美国贫困区街道，简而言之就是比中国农村宽敞一点），左上角的背景把那座高塔画上——被B埋伏，开始向塔逃去"}]},{"ID":"20260626181804-4coo6k0","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-4coo6k0","updated":"20260626170002"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-card-info-background); color: var(--b3-card-info-color);"},"TextMarkType":"mark text","TextMarkTextContent":"B4"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-card-info-background); color: var(--b3-card-info-color);\"}"},{"Type":"NodeText","Data":"/"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-card-error-background); color: var(--b3-card-error-color);"},"TextMarkType":"mark text","TextMarkTextContent":"A4"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-card-error-background); color: var(--b3-card-error-color);\"}"},{"Type":"NodeText","Data":":"}]},{"ID":"20260626181804-xrs3l3f","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181804-xrs3l3f","updated":"20260626180644"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"进入三阶段"},{"Type":"NodeText","Data":"，听到楼下的敲门声，B先去阁楼取枪，然后去门口取道具，接下来是一段gameplay，B边躲鬼边完成剩下游戏流程，一边打枪关门溜鬼，一边在游戏机上爬塔，此时鬼被门阻挡拍门时玩家也能听到自己被拍门，（我想在这段来一段后朋风格的"},{"Type":"NodeTextMark","TextMarkType":"mark","TextMarkTextContent":"配乐"},{"Type":"NodeText","Data":"，我也不知道为什么（）——最终完成了游戏流程"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-card-error-background); color: var(--b3-card-error-color);"},"TextMarkType":"text","TextMarkTextContent":"（A到达最高层并跳下去）"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-card-error-background); color: var(--b3-card-error-color);\"}"},{"Type":"NodeText","Data":"，按照要求回到自己的房间，给门贴上符咒，在鬼的一阵阵拍门声与怒吼声中删除了旧存档。这时候外面传来逐渐微弱的惨叫声，B也莫名感到一阵晕眩，向下倒下去，然后又丝滑地从地面平躺位来了个凭空起立，180°翻转到了游戏里地下室的位置，此时外面占据了自己身体的A告诉了他事情的真相——闪回他当时变为游魂那部分的绝望记忆（这里要注意惊悚悬疑的"},{"Type":"NodeTextMark","TextMarkType":"mark","TextMarkTextContent":"音乐"},{"Type":"NodeText","Data":"）——游戏黑屏，B讲述自己的结局，来软的并假装自己是无辜者，求玩家把他解放出来，玩家不删他的存档的话，语气就会逐渐变得不对起来（这里也要注意"},{"Type":"NodeTextMark","TextMarkType":"mark","TextMarkTextContent":"音乐"},{"Type":"NodeText","Data":"配合），选择来硬的承认自己就是B，恐吓威慑玩家删除存档，使玩家意识到自己也完成了被夺舍的条件，且自己的门外不断传来拍门声与怒吼声，屏幕跳到存档界面，此时锁定旧存档，返回、删除、读取键全都变成“删除”。若玩家在这期间点，则先黑屏然后出现一只大眼睛，放大向玩家“扑过来”。若玩家10秒不点，则一切寂静下来，B对你表示愤恨并将要去搜寻下一个目标——无论如何，接下来游戏结束并附上开发者感谢黑屏。"}]},{"ID":"20260621202651-z6awzxc","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260621202651-z6awzxc","updated":"20260621202101"},"Children":[{"Type":"NodeText","Data":"（注：此处的A1 A2 A3 A4是代指玩游戏机的4段流程区分）"}]},{"ID":"20260620201445-0emm5tc","Type":"NodeHeading","HeadingLevel":1,"Properties":{"fold":"1","id":"20260620201445-0emm5tc","updated":"20260621202800"},"Children":[{"Type":"NodeText","Data":"美术资源需求"}]},{"ID":"20260626181724-6pzlj1t","Type":"NodeHeading","HeadingLevel":2,"Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-6pzlj1t","updated":"20260621202754"},"Children":[{"Type":"NodeText","Data":"UI图标"}]},{"ID":"20260626181724-f5yotjd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-f5yotjd","updated":"20260625023335"},"Children":[{"Type":"NodeText","Data":"刚进入游戏要求电脑与门相对位置时的俯视图美术素材"}]},{"ID":"20260626181724-cnbpqwz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-cnbpqwz","updated":"20260626181724"},"Children":[{"Type":"NodeText","Data":"B游戏流程的3D资产"}]},{"ID":"20260626181724-voue7aa","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-voue7aa","updated":"20260625032337"},"Children":[{"Type":"NodeText","Data":"主要色调在黄昏阶段多使用暖黄（但不要太暖，可以降点饱和度），在入夜后使用暗色调，整体加一个偏灰蓝滤镜，显得阴暗"}]},{"ID":"20260626181724-46rd8ko","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-46rd8ko","updated":"20260626171737"},"Children":[{"Type":"NodeText","Data":"具体资产你俩自己找吧（"}]},{"ID":"20260626181724-vm0g0dk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-vm0g0dk","updated":"20260626181724"},"Children":[{"Type":"NodeText","Data":"A游戏流程的2D背景"}]},{"ID":"20260626181724-l3i47il","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-l3i47il","updated":"20260625032322"},"Children":[{"Type":"NodeText","Data":"以红黑色为主色调，尽可能显得压抑"}]},{"ID":"20260626181724-68ofhq3","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-68ofhq3","updated":"20260626174905"},"Children":[{"Type":"NodeText","Data":"整体任务和背景关系的处理参考《烟火》"}]},{"ID":"20260626181724-qs2ffoo","Type":"NodeHeading","HeadingLevel":3,"Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-qs2ffoo","updated":"20260626181724"},"Children":[{"Type":"NodeText","Data":"场景背景图"}]},{"ID":"20260626181724-0ity7qd","Type":"NodeList","ListData":{},"Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-0ity7qd","updated":"20260626172341"},"Children":[{"ID":"20260626181724-1ckbky0","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-1ckbky0","updated":"20260626172341"},"Children":[{"ID":"20260626181724-d7n65a9","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-d7n65a9","updated":"20260626172341"},"Children":[{"Type":"NodeText","Data":"有点破败、沿途有好几个垃圾桶的美国街巷，比较长"}]}]}]},{"ID":"20260626181724-ytbl9r4","Type":"NodeList","ListData":{},"Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-ytbl9r4","updated":"20260626172239"},"Children":[{"ID":"20260626181724-outyzsz","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-outyzsz","updated":"20260626171752"},"Children":[{"ID":"20260626181724-wyc4qu7","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-wyc4qu7","updated":"20260626171759"},"Children":[{"Type":"NodeText","Data":"学校食堂，背景里还有不少在吃饭的人影"}]}]},{"ID":"20260626181724-r27vvd9","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-r27vvd9","updated":"20260626171808"},"Children":[{"ID":"20260626181724-vzygbw7","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-vzygbw7","updated":"20260626171823"},"Children":[{"Type":"NodeText","Data":"学校更衣室"}]}]},{"ID":"20260626181724-q8azfcz","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-q8azfcz","updated":"20260626171820"},"Children":[{"ID":"20260626181724-4kqz2e5","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-4kqz2e5","updated":"20260626172156"},"Children":[{"Type":"NodeText","Data":"A的家，中心是一个餐桌（这个不用画，到时候用模型，把位置留出来就行），整体比较破，背景有电动车，笔记本电脑，以及两个相框（一个是年轻夫妻，即A的父母，一个是十多年后的的父子，即A和父亲）"}]}]},{"ID":"20260626181724-katiajd","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-katiajd","updated":"20260626172001"},"Children":[{"ID":"20260626181724-1nx0wzu","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-1nx0wzu","updated":"20260626172116"},"Children":[{"Type":"NodeText","Data":"整座高塔的超长背景（可以偷懒重复拼接几次）"}]}]},{"ID":"20260626181724-yama544","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-yama544","updated":"20260626172159"},"Children":[{"ID":"20260626181724-sg9mvxc","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-sg9mvxc","updated":"20260626172210"},"Children":[{"Type":"NodeText","Data":"塔的顶部内外，具体来讲有一个不怎么长的延伸平台，里面风格还是塔，外边是星空和下面城市的光亮"}]}]},{"ID":"20260626181724-5521re9","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-5521re9","updated":"20260626172213"},"Children":[{"ID":"20260626181724-mvecl02","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-mvecl02","updated":"20260626172231"},"Children":[{"Type":"NodeText","Data":"地下室场景，比较有巫师地下室那种破败且带点邪性的感觉，色调脏黄一些"}]}]},{"ID":"20260626181724-57rct01","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-57rct01","updated":"20260626172239"},"Children":[{"ID":"20260626181724-hvviwsd","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-hvviwsd","updated":"20260626180224"},"Children":[{"Type":"NodeText","Data":"家门口的街道（美国贫困区街道，简而言之就是比中国农村宽敞一点，房子更大点），左上角的背景把那座高塔画上"}]}]}]},{"ID":"20260626181724-mkd9c6d","Type":"NodeHeading","HeadingLevel":3,"Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-mkd9c6d","updated":"20260626181724"},"Children":[{"Type":"NodeText","Data":"插画图"}]},{"ID":"20260626181724-d47eg6r","Type":"NodeList","ListData":{},"Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-d47eg6r","updated":"20260626172501"},"Children":[{"ID":"20260626181724-a45t14d","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-a45t14d","updated":"20260626172501"},"Children":[{"ID":"20260626181724-5s9mg1w","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-5s9mg1w","updated":"20260626172501"},"Children":[{"Type":"NodeText","Data":"一座高塔从地面向上仰视的“全身”图"}]}]}]},{"ID":"20260626181724-bedq3e0","Type":"NodeList","ListData":{},"Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-bedq3e0","updated":"20260626172511"},"Children":[{"ID":"20260626181724-5wbebb2","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-5wbebb2","updated":"20260626172511"},"Children":[{"ID":"20260626181724-y1nnhxf","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181724-y1nnhxf","updated":"20260626172511"},"Children":[{"Type":"NodeText","Data":"从塔顶向下看城市的俯视图"}]}]}]},{"ID":"20260621202800-i6snnim","Type":"NodeHeading","HeadingLevel":2,"Properties":{"fold":"1","heading-fold":"1","id":"20260621202800-i6snnim","updated":"20260621202754"},"Children":[{"Type":"NodeText","Data":"UI图标"}]},{"ID":"20260621202800-pgh4gsp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"fold":"1","heading-fold":"1","id":"20260621202800-pgh4gsp","updated":"20260621202755"},"Children":[{"Type":"NodeText","Data":"刚进入游戏要求电脑与门相对位置时的俯视图美术素材"}]},{"ID":"20260621202800-nqx4cfa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"fold":"1","heading-fold":"1","id":"20260621202800-nqx4cfa","updated":"20260621202756"},"Children":[{"Type":"NodeText","Data":"A游戏流程的2D背景"}]},{"ID":"20260626181957-6fvkzpl","Type":"NodeHeading","HeadingLevel":1,"Properties":{"fold":"1","id":"20260626181957-6fvkzpl","updated":"20260626182010"},"Children":[{"Type":"NodeText","Data":"音效需求"}]},{"ID":"20260626182010-wa6fdnp","Type":"NodeHeading","HeadingLevel":3,"Properties":{"fold":"1","heading-fold":"1","id":"20260626182010-wa6fdnp","updated":"20260626172828"},"Children":[{"Type":"NodeText","Data":"音乐"}]},{"ID":"20260626182010-duobvhj","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626182010-duobvhj","updated":"20260626181205"},"Children":[{"Type":"NodeText","Data":"数首恐怖惊悚悬疑风格的长短不一，又不是很热门的可用曲子，拿来做BGM备用库。"}]},{"ID":"20260626182010-93794cx","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626182010-93794cx","updated":"20260626181059"},"Children":[{"Type":"NodeText","Data":"一段用于最后追逐对抗战的曲子，我希望它同时有一定的节奏感、焦虑感、冷漠疏离、略微悲伤的感觉。我是希望能在后朋克风格里面找找有没有这种感觉的曲子。"}]},{"ID":"20260626182010-0jiar7f","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626182010-0jiar7f","updated":"20260626181517"},"Children":[{"Type":"NodeText","Data":"后面的两次反转找找有没有合适的那种让人后背发凉的短音乐，可以参考《潜伏1》结尾男主角在阴间喊“no”时的音效，以及打泥泥2022-5-13视频结尾、2020-4-28视频结尾的音效（其实基本上他每个悬疑细思极恐风视频的结尾音乐基本都可以用或者参考一下feel，他在和配乐配合这方面太轻车熟路了）"}]},{"ID":"20260626182010-1z5rowk","Type":"NodeHeading","HeadingLevel":3,"Properties":{"fold":"1","heading-fold":"1","id":"20260626182010-1z5rowk","updated":"20260626172830"},"Children":[{"Type":"NodeText","Data":"音效"}]},{"ID":"20260626182010-ma2robe","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626182010-ma2robe","updated":"20260626174615"},"Children":[{"Type":"NodeText","Data":"老游戏那种“叮”的切换或选择提示音"}]},{"ID":"20260626182010-nesiedc","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626182010-nesiedc","updated":"20260626174027"},"Children":[{"Type":"NodeText","Data":"键盘或其他按钮按下声"}]},{"ID":"20260626182010-m2901hh","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626182010-m2901hh","updated":"20260626174040"},"Children":[{"Type":"NodeText","Data":"键盘或其他按钮抬起声"}]},{"ID":"20260626182010-zxgfe5w","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626182010-zxgfe5w","updated":"20260626174350"},"Children":[{"Type":"NodeText","Data":"非常核心的拍门声，要两个版本，一个是正常清脆的版本，一个是像是隔着耳机听到现实里拍门声的发闷版本，两者可以都多找几个版本，轻重节奏不同的，拍的次数不同的，备用"}]},{"ID":"20260626182010-x2s3mmy","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626182010-x2s3mmy","updated":"20260626174525"},"Children":[{"Type":"NodeText","Data":"相对正常的敲门声"}]},{"ID":"20260626182010-v03t4oc","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626182010-v03t4oc","updated":"20260626174710"},"Children":[{"Type":"NodeText","Data":"扭门把手开门声"}]},{"ID":"20260626182010-8nhjivi","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626182010-8nhjivi","updated":"20260626174732"},"Children":[{"Type":"NodeText","Data":"木头的“吱呀”声"}]},{"ID":"20260626182010-0hxwius","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626182010-0hxwius","updated":"20260626174801"},"Children":[{"Type":"NodeText","Data":"在木地板上的走路声（清脆一些）"}]},{"ID":"20260626182010-8wliw3b","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626182010-8wliw3b","updated":"20260626174950"},"Children":[{"Type":"NodeText","Data":"在较硬地面上的走步声"}]},{"ID":"20260626182010-r6vog9m","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626182010-r6vog9m","updated":"20260626175046"},"Children":[{"Type":"NodeText","Data":"铁餐盘掉地上的声音"}]},{"ID":"20260626182010-rqfhy36","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626182010-rqfhy36","updated":"20260626175233"},"Children":[{"Type":"NodeText","Data":"房门“吱呀”慢慢打开的声"}]},{"ID":"20260626182010-lw9ubin","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626182010-lw9ubin","updated":"20260626175245"},"Children":[{"Type":"NodeText","Data":"钢水杯掉地上以及在地上滚动的声"}]},{"ID":"20260626182010-mvim1gy","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626182010-mvim1gy","updated":"20260626175247"},"Children":[{"Type":"NodeText","Data":"风声"}]},{"ID":"20260626182010-yo1ngqw","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626182010-yo1ngqw","updated":"20260626180657"},"Children":[{"Type":"NodeText","Data":"在餐桌前生气拍桌子的声音"}]},{"ID":"20260626182010-6w7x47r","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626182010-6w7x47r","updated":"20260626175328"},"Children":[{"Type":"NodeText","Data":"小摆钟的“咔擦，咔擦”声"}]},{"ID":"20260626182010-c8xjbi1","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626182010-c8xjbi1","updated":"20260626180306"},"Children":[{"Type":"NodeText","Data":"大门被锁住开不开的声音（锁链摇晃声）"}]},{"ID":"20260626182010-4xwa67y","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626182010-4xwa67y","updated":"20260626181035"},"Children":[{"Type":"NodeText","Data":"跳跃后从大约50cm高的高度落到地面上的落地声"}]},{"ID":"20260626182010-lpm9xka","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626182010-lpm9xka","updated":"20260626180740"},"Children":[{"Type":"NodeText","Data":"鬼恐惧又愤怒的吼叫声"}]},{"ID":"20260626182010-wgbvpkf","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626182010-wgbvpkf","updated":"20260626180749"},"Children":[{"Type":"NodeText","Data":"开枪声"}]},{"ID":"20260626182010-fejqpau","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626182010-fejqpau","updated":"20260626180827"},"Children":[{"Type":"NodeText","Data":"触电声（让触电者兹拉兹拉冒烟那种感觉）"}]},{"ID":"20260626182010-b2ulnhx","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626182010-b2ulnhx","updated":"20260626181201"},"Children":[{"Type":"NodeText","Data":"那种非常典型的惊悚悬疑惊吓音效（噔~），多找几个备用"}]},{"ID":"20260620201551-ubbir24","Type":"NodeHeading","HeadingLevel":1,"Properties":{"fold":"1","id":"20260620201551-ubbir24","updated":"20260626181735"},"Children":[{"Type":"NodeText","Data":"开发周期预设与版本日志"}]},{"ID":"20260626181735-psabrs1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"fold":"1","heading-fold":"1","id":"20260626181735-psabrs1","updated":"20260626181735"},"Children":[{"Type":"NodeText","Data":"周期预设"}]},{"ID":"20260626181735-bb7pb5t","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181735-bb7pb5t","updated":"20260626140533"},"Children":[{"Type":"NodeText","Data":"2.27-7.3（正好一周七天），内容生产，并入主干，形成成品"}]},{"ID":"20260626181735-7w5be5v","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181735-7w5be5v","updated":"20260626140525"},"Children":[{"Type":"NodeText","Data":"7.4-7.6，修BUG，准备各种提交材料"}]},{"ID":"20260626181735-3h052iq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"fold":"1","heading-fold":"1","id":"20260626181735-3h052iq","updated":"20260626181735"},"Children":[{"Type":"NodeText","Data":"分工"}]},{"ID":"20260626181735-bu4pk9f","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181735-bu4pk9f","updated":"20260626140819"},"Children":[{"Type":"NodeText","Data":"程序*3"}]},{"ID":"20260626181735-8rykc6n","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181735-8rykc6n","updated":"20260626140827"},"Children":[{"Type":"NodeText","Data":"地编A，地编B"}]},{"ID":"20260626181735-977v9se","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181735-977v9se","updated":"20260626140830"},"Children":[{"Type":"NodeText","Data":"音频"}]},{"ID":"20260626181735-xpf19yx","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181735-xpf19yx","updated":"20260626140834"},"Children":[{"Type":"NodeText","Data":"2D美术"}]},{"ID":"20260626181735-ji5enw8","Type":"NodeParagraph","Properties":{"fold":"1","heading-fold":"1","id":"20260626181735-ji5enw8","updated":"20260626154112"},"Children":[{"Type":"NodeText","